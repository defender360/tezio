APP_NAME="Defender360 ITSM Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Multi-tenancy Configuration
TENANT_DB_PREFIX=tenant_
TENANT_DOMAIN_SUFFIX=.defender360.local
CENTRAL_DOMAIN=defender360.local
TENANT_IDENTIFICATION=subdomain

# Database Configuration
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=itsm_platform
DB_USERNAME=itsm_user
DB_PASSWORD=secure_password_here

# Redis Configuration
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

# Cache Configuration
CACHE_DRIVER=redis
CACHE_PREFIX=defender360_

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue Configuration
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database

# Broadcast Configuration
BROADCAST_CONNECTION=pusher
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=local-app-id
PUSHER_APP_KEY=local-app-key
PUSHER_APP_SECRET=local-app-secret
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# Laravel WebSockets Configuration
LARAVEL_WEBSOCKETS_PORT=6001
LARAVEL_WEBSOCKETS_SSL_LOCAL_CERT=null
LARAVEL_WEBSOCKETS_SSL_LOCAL_PK=null
LARAVEL_WEBSOCKETS_SSL_PASSPHRASE=null

# Mail Configuration
MAIL_MAILER=sendgrid
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=YOUR_SENDGRID_API_KEY
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@defender360.com.br"
MAIL_FROM_NAME="Defender360"

# SendGrid Configuration
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
SENDGRID_ACCOUNT_ID=YOUR_SENDGRID_ACCOUNT_ID

# Magic Link & 2FA Configuration
MAGIC_LINK_EXPIRES_MINUTES=15
TWO_FACTOR_CODE_EXPIRES_MINUTES=10

# AWS Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sanctum Configuration
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:80,localhost:8000,127.0.0.1,127.0.0.1:8000,::1

# Session Configuration for Sanctum
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

# AI Service Configuration
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_KEY=internal_api_key_here

# Claude AI Configuration
ANTHROPIC_API_KEY=YOUR_CLAUDE_API_KEY
CLAUDE_MODEL=claude-3-opus-20240229
CLAUDE_MAX_TOKENS=4096

# OpenAI Configuration (Fallback)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4-turbo-preview

# Elasticsearch Configuration
ELASTICSEARCH_HOST=elasticsearch:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=itsm_

# Monitoring Configuration
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# Security Configuration
MFA_ENABLED=true
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true
SESSION_SECURE_COOKIE=true
API_RATE_LIMIT=60

# SLA Configuration
SLA_CALCULATION_METHOD=business_hours
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=18:00
BUSINESS_DAYS=1,2,3,4,5
HOLIDAYS_API_KEY=

# Backup Configuration
BACKUP_NOTIFICATION_EMAIL=admin@defender360.com
BACKUP_DISK=s3
BACKUP_RETENTION_DAYS=30

# Feature Flags
FEATURE_AI_SUGGESTIONS=true
FEATURE_PREDICTIVE_ANALYTICS=true
FEATURE_ADVANCED_WORKFLOWS=true
FEATURE_WHITE_LABEL=false
FEATURE_API_MARKETPLACE=false

# Performance Configuration
DB_POOL_MIN=10
DB_POOL_MAX=100
REDIS_POOL_MIN=10
REDIS_POOL_MAX=50
HTTP_TIMEOUT=30
QUEUE_WORKER_MEMORY=128
QUEUE_WORKER_TIMEOUT=60

# Development Tools
DEBUGBAR_ENABLED=false
TELESCOPE_ENABLED=true
HORIZON_ENABLED=true
PULSE_ENABLED=true

# Docker Internal Network
DOCKER_NETWORK=itsm-network

# Vite Configuration (for asset building)
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Datto RMM Integration
DATTO_RMM_API_URL=https://api.datto.com
DATTO_RMM_AUTH_URL=https://api.datto.com/auth/oauth/token
DATTO_RMM_API_KEY=YOUR_DATTO_API_KEY
DATTO_RMM_API_SECRET=YOUR_DATTO_API_SECRET

# Master Site Configuration
DATTO_RMM_MASTER_SITE_UID=YOUR_MASTER_SITE_UID
DATTO_RMM_MASTER_SITE_ID=YOUR_MASTER_SITE_ID
DATTO_RMM_MASTER_SITE_NAME=YOUR_MASTER_SITE_NAME

# Bitdefender Integration  
BITDEFENDER_API_URL=https://cloudgz.gravityzone.bitdefender.com/api/v1.0
BITDEFENDER_API_KEY=YOUR_BITDEFENDER_API_KEY
BITDEFENDER_COMPANY_ID=YOUR_BITDEFENDER_COMPANY_ID

# MCP Integration
PIPEDREAM_WORKSPACE_ID=YOUR_PIPEDREAM_WORKSPACE_ID
PIPEDREAM_MCP_SERVER_URL=https://mcp.pipedream.net/YOUR_MCP_SERVER_ID/{app_slug}
PIPEDREAM_CONNECT_CLIENT_ID=YOUR_PIPEDREAM_CLIENT_ID
PIPEDREAM_CONNECT_CLIENT_SECRET=YOUR_PIPEDREAM_CLIENT_SECRET

# Supermemory MCP Configuration
SUPERMEMORY_API_KEY=YOUR_SUPERMEMORY_API_KEY