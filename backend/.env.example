APP_NAME="Defender360 ITSM Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Multi-tenancy Configuration
TENANT_DB_PREFIX=tenant_
TENANT_DOMAIN_SUFFIX=.defender360.local
CENTRAL_DOMAIN=defender360.local
TENANT_IDENTIFICATION=subdomain

# Database Configuration
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=itsm_platform
DB_USERNAME=itsm_user
DB_PASSWORD=secure_password_here

# Redis Configuration
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

# Cache Configuration
CACHE_DRIVER=redis
CACHE_PREFIX=defender360_

# Session Configuration
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue Configuration
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database

# Broadcast Configuration
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@defender360.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Auth0 Configuration
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_REDIRECT_URI=${APP_URL}/auth/callback
AUTH0_LOGOUT_URI=${APP_URL}
AUTH0_AUDIENCE=
AUTH0_MANAGEMENT_API_TOKEN=

# AI Service Configuration
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_KEY=internal_api_key_here

# Claude AI Configuration
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-opus-20240229
CLAUDE_MAX_TOKENS=4096

# OpenAI Configuration (Fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# Elasticsearch Configuration
ELASTICSEARCH_HOST=elasticsearch:9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=itsm_

# Monitoring Configuration
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# Security Configuration
MFA_ENABLED=true
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true
SESSION_SECURE_COOKIE=true
API_RATE_LIMIT=60

# SLA Configuration
SLA_CALCULATION_METHOD=business_hours
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=18:00
BUSINESS_DAYS=1,2,3,4,5
HOLIDAYS_API_KEY=

# Backup Configuration
BACKUP_NOTIFICATION_EMAIL=admin@defender360.com
BACKUP_DISK=s3
BACKUP_RETENTION_DAYS=30

# Feature Flags
FEATURE_AI_SUGGESTIONS=true
FEATURE_PREDICTIVE_ANALYTICS=true
FEATURE_ADVANCED_WORKFLOWS=true
FEATURE_WHITE_LABEL=false
FEATURE_API_MARKETPLACE=false

# Performance Configuration
DB_POOL_MIN=10
DB_POOL_MAX=100
REDIS_POOL_MIN=10
REDIS_POOL_MAX=50
HTTP_TIMEOUT=30
QUEUE_WORKER_MEMORY=128
QUEUE_WORKER_TIMEOUT=60

# Development Tools
DEBUGBAR_ENABLED=false
TELESCOPE_ENABLED=true
HORIZON_ENABLED=true
PULSE_ENABLED=true

# Docker Internal Network
DOCKER_NETWORK=itsm-network

# Vite Configuration (for asset building)
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"