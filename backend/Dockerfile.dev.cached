# Development Dockerfile with better caching
FROM php:8.3-fpm-alpine AS php-base

# Install system dependencies
RUN apk add --no-cache \
    git \
    curl \
    libpng \
    libjpeg-turbo \
    freetype \
    icu \
    libxml2 \
    libzip \
    oniguruma \
    postgresql-libs \
    nodejs \
    npm

# Build stage for PHP extensions
FROM php-base AS php-ext-builder

RUN apk add --no-cache --virtual .build-deps \
    $PHPIZE_DEPS \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    icu-dev \
    libxml2-dev \
    libzip-dev \
    oniguruma-dev \
    postgresql-dev \
    linux-headers

# Configure and install PHP extensions
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        pdo \
        pdo_pgsql \
        mbstring \
        exif \
        pcntl \
        bcmath \
        gd \
        zip \
        intl \
        opcache \
        soap \
        sockets

# Install PECL extensions separately to cache better
RUN pecl install redis-6.0.2 && docker-php-ext-enable redis
RUN pecl install xdebug-3.3.1 && docker-php-ext-enable xdebug
RUN pecl install pcov && docker-php-ext-enable pcov

# Final stage
FROM php-base AS final

# Copy PHP extensions from builder
COPY --from=php-ext-builder /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=php-ext-builder /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Configure PHP
RUN { \
        echo 'memory_limit=512M'; \
        echo 'upload_max_filesize=100M'; \
        echo 'post_max_size=100M'; \
        echo 'max_execution_time=600'; \
        echo 'display_errors=On'; \
        echo 'display_startup_errors=On'; \
        echo 'error_reporting=E_ALL'; \
        echo 'log_errors=On'; \
    } > /usr/local/etc/php/conf.d/docker-php-development.ini

# Configure Xdebug
RUN { \
        echo 'xdebug.mode=develop,debug,coverage'; \
        echo 'xdebug.client_host=host.docker.internal'; \
        echo 'xdebug.start_with_request=yes'; \
        echo 'xdebug.log=/tmp/xdebug.log'; \
    } >> /usr/local/etc/php/conf.d/docker-php-ext-xdebug.ini

# Create user
RUN addgroup -g 1000 -S developer && \
    adduser -u 1000 -S developer -G developer

WORKDIR /var/www/html

# Create directories
RUN mkdir -p storage/app/public storage/framework/cache storage/framework/sessions \
    storage/framework/views storage/logs bootstrap/cache \
    && chown -R developer:developer /var/www/html \
    && chmod -R 775 storage bootstrap/cache

USER developer

# Copy composer files
COPY --chown=developer:developer composer.json composer.lock* ./

# Install dependencies if they exist
RUN if [ -f "composer.lock" ] && grep -q '"packages"' composer.lock 2>/dev/null; then \
        composer install --no-scripts --no-autoloader; \
    fi

# Copy application
COPY --chown=developer:developer . .

# Generate autoloader if vendor exists
RUN if [ -d "vendor" ]; then \
        composer dump-autoload --optimize; \
    fi

EXPOSE 9000

CMD ["php-fpm"]