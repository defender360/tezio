{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "analyzer": {
        "article_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "asciifolding",
            "stop",
            "word_delimiter",
            "snowball"
          ]
        },
        "autocomplete_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "asciifolding",
            "autocomplete_filter"
          ]
        },
        "tag_analyzer": {
          "type": "custom",
          "tokenizer": "keyword",
          "filter": [
            "lowercase",
            "asciifolding"
          ]
        }
      },
      "filter": {
        "autocomplete_filter": {
          "type": "edge_ngram",
          "min_gram": 2,
          "max_gram": 20,
          "token_chars": [
            "letter",
            "digit"
          ]
        },
        "snowball": {
          "type": "snowball",
          "language": "english"
        },
        "word_delimiter": {
          "type": "word_delimiter",
          "generate_word_parts": true,
          "generate_number_parts": true,
          "split_on_case_change": true,
          "split_on_numerics": true,
          "stem_english_possessive": true
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "id": {
        "type": "keyword"
      },
      "title": {
        "type": "text",
        "analyzer": "article_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          },
          "autocomplete": {
            "type": "text",
            "analyzer": "autocomplete_analyzer",
            "search_analyzer": "standard"
          }
        }
      },
      "slug": {
        "type": "keyword"
      },
      "content": {
        "type": "text",
        "analyzer": "article_analyzer",
        "fields": {
          "highlight": {
            "type": "text",
            "analyzer": "article_analyzer",
            "term_vector": "with_positions_offsets"
          }
        }
      },
      "excerpt": {
        "type": "text",
        "analyzer": "article_analyzer"
      },
      "tags": {
        "type": "keyword",
        "normalizer": "lowercase"
      },
      "category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "keyword"
          },
          "name": {
            "type": "text",
            "analyzer": "article_analyzer",
            "fields": {
              "keyword": {
                "type": "keyword"
              }
            }
          },
          "slug": {
            "type": "keyword"
          }
        }
      },
      "author": {
        "type": "object",
        "properties": {
          "id": {
            "type": "keyword"
          },
          "name": {
            "type": "text",
            "fields": {
              "keyword": {
                "type": "keyword"
              }
            }
          },
          "email": {
            "type": "keyword"
          }
        }
      },
      "status": {
        "type": "keyword"
      },
      "featured": {
        "type": "boolean"
      },
      "meta_description": {
        "type": "text",
        "analyzer": "article_analyzer"
      },
      "meta_keywords": {
        "type": "keyword"
      },
      "view_count": {
        "type": "integer"
      },
      "helpful_count": {
        "type": "integer"
      },
      "not_helpful_count": {
        "type": "integer"
      },
      "average_rating": {
        "type": "float"
      },
      "published_at": {
        "type": "date",
        "format": "yyyy-MM-dd HH:mm:ss||yyyy-MM-dd||epoch_millis"
      },
      "created_at": {
        "type": "date",
        "format": "yyyy-MM-dd HH:mm:ss||yyyy-MM-dd||epoch_millis"
      },
      "updated_at": {
        "type": "date",
        "format": "yyyy-MM-dd HH:mm:ss||yyyy-MM-dd||epoch_millis"
      },
      "internal_notes": {
        "type": "text",
        "index": false
      },
      "version": {
        "type": "integer"
      },
      "tenant_id": {
        "type": "keyword"
      },
      "suggest": {
        "type": "completion",
        "analyzer": "simple",
        "preserve_separators": true,
        "preserve_position_increments": true,
        "max_input_length": 50
      }
    }
  }
}